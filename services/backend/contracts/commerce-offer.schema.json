{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldmakers.example/schemas/commerce-offer.schema.json",
  "title": "World Makers Parent Commerce Offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "offerId",
    "productType",
    "entitlementIds",
    "platformSkus",
    "parentAudienceOnly",
    "randomizedContent",
    "manipulativeUrgency",
    "consumableCurrency"
  ],
  "properties": {
    "offerId": {
      "type": "string",
      "pattern": "^offer\\.[a-z0-9][a-z0-9._-]+$"
    },
    "productType": {
      "type": "string",
      "enum": ["base_game", "expansion", "creative_pack", "cosmetic_pack", "family_subscription", "institutional_license"]
    },
    "entitlementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^entitlement\\.[a-z0-9][a-z0-9._-]+$"}
    },
    "platformSkus": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "parentAudienceOnly": {"const": true},
    "randomizedContent": {"const": false},
    "manipulativeUrgency": {"const": false},
    "consumableCurrency": {"const": false},
    "childInterestEligible": {"type": "boolean"},
    "descriptionKey": {"type": "string", "minLength": 1}
  }
}
