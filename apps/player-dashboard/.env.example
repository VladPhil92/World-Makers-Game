# Local/demo only. Never enable demo auth in production.
WORLD_MAKERS_ALLOW_DEMO_AUTH=false

# D2 CTG One identity bridge. Use independent high-entropy values in production.
WORLD_MAKERS_IDENTITY_ASSERTION_SECRET=
WORLD_MAKERS_IDENTITY_LINK_SECRET=

# Production Supabase profile persistence. The anon key is only the transport
# credential; profile RPCs additionally require the server-only bridge secret.
SUPABASE_URL=
SUPABASE_ANON_KEY=
WORLD_MAKERS_PROFILE_BRIDGE_SECRET=

# Optional reference file adapter path for non-Supabase development.
WORLD_MAKERS_PROFILE_STORE_PATH=

# D1/D2 signed native launch context.
WORLD_MAKERS_LAUNCH_SIGNING_SECRET=

PORT=4273
