# Local/demo only. Never enable demo auth in production.
WORLD_MAKERS_ALLOW_DEMO_AUTH=false

# D2 CTG One identity bridge. Use independent high-entropy values in production.
WORLD_MAKERS_IDENTITY_ASSERTION_SECRET=
WORLD_MAKERS_IDENTITY_LINK_SECRET=

# Explicit persistent profile location. Required when NODE_ENV=production for the reference file adapter.
WORLD_MAKERS_PROFILE_STORE_PATH=

# D1/D2 signed Unreal launch context.
WORLD_MAKERS_LAUNCH_SIGNING_SECRET=

PORT=4273
