# Public URL of the World Makers backend gateway/API selected in M4.2.
WORLD_MAKERS_API_BASE_URL=http://localhost:8080

# Production provider selection remains intentionally unresolved in M4.1.
AUTH_PROVIDER=UNDECIDED

# Local-only demo guardian session. Never enable this in production.
WORLD_MAKERS_ALLOW_DEMO_AUTH=false

# Local web server port.
PORT=4173

# Never place private server credentials in browser-exposed environment variables.
