# Production Supabase project used for guardian auth/family data.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only profile bridge secret. Required for privacy deletion of the linked
# player profile after public execution on the legacy profile RPCs was revoked.
WORLD_MAKERS_PROFILE_BRIDGE_SECRET=

# Parent -> Player Hub identity handoff.
WORLD_MAKERS_IDENTITY_ASSERTION_SECRET=
WORLD_MAKERS_PLAYER_DASHBOARD_URL=

# Local-only demo guardian session. Never enable this in production.
WORLD_MAKERS_ALLOW_DEMO_AUTH=false

# Local web server port.
PORT=4173

# Never place private server credentials in browser-exposed environment variables.
