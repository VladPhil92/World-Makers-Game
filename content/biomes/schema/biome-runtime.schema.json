{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldmakers.invalid/schema/biome-runtime.schema.json",
  "title": "World Makers biome runtime definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "prototypeOnly", "originCm", "zones", "pointsOfInterest"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "id": {"type": "string", "pattern": "^biome\\.[a-z0-9.-]+$"},
    "prototypeOnly": {"type": "boolean"},
    "originCm": {"$ref": "#/$defs/vector3"},
    "zones": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/zone"}
    },
    "pointsOfInterest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pointOfInterest"}
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "centerCm", "extentCm", "buildAllowed", "missionIds"],
      "properties": {
        "id": {"type": "string", "pattern": "^zone\\.[a-z0-9.-]+$"},
        "kind": {"type": "string"},
        "centerCm": {"$ref": "#/$defs/vector3"},
        "extentCm": {"$ref": "#/$defs/vector3"},
        "buildAllowed": {"type": "boolean"},
        "missionIds": {
          "type": "array",
          "items": {"type": "string", "pattern": "^mission\\.[a-z0-9.-]+$"}
        }
      }
    },
    "pointOfInterest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "zoneId", "category", "locationCm", "discoveryRadiusCm", "discoveryId"],
      "properties": {
        "id": {"type": "string", "pattern": "^poi\\.[a-z0-9.-]+$"},
        "zoneId": {"type": "string", "pattern": "^zone\\.[a-z0-9.-]+$"},
        "category": {"type": "string"},
        "locationCm": {"$ref": "#/$defs/vector3"},
        "discoveryRadiusCm": {"type": "number", "minimum": 50, "maximum": 2000},
        "discoveryId": {"type": "string", "pattern": "^discovery\\.[a-z0-9.-]+$"}
      }
    }
  }
}
