{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldmakers.local/schemas/n3-native-package-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "platform",
    "profileId",
    "unrealVersion",
    "buildCommit",
    "packageKind",
    "packageFile",
    "packageSha256",
    "packageSizeBytes",
    "signatureVerified",
    "installVerified",
    "launchVerified",
    "automationPassed",
    "runtimeTakeoverVerified",
    "crashCount",
    "smokeSessionSeconds",
    "smokeChecks",
    "installLogFile",
    "installLogSha256",
    "runtimeLogFile",
    "runtimeLogSha256",
    "screenshotFile",
    "screenshotSha256",
    "v8EvidenceFile",
    "v8EvidenceSha256"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["pending", "passed", "failed"]},
    "platform": {"enum": ["Android", "iPadOS"]},
    "profileId": {"enum": ["performance.tablet.low", "performance.tablet.medium", "performance.tablet.high"]},
    "unrealVersion": {"const": "5.8.2"},
    "buildCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "packageKind": {"enum": ["apk", "aab", "ipa"]},
    "packageFile": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240},
    "packageSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packageSizeBytes": {"type": "integer", "minimum": 1},
    "signatureVerified": {"type": "boolean"},
    "installVerified": {"type": "boolean"},
    "launchVerified": {"type": "boolean"},
    "automationPassed": {"type": "boolean"},
    "runtimeTakeoverVerified": {"type": "boolean"},
    "crashCount": {"type": "integer", "minimum": 0},
    "smokeSessionSeconds": {"type": "integer", "minimum": 0},
    "smokeChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot-to-playable-world",
        "move-and-camera",
        "place-build-piece",
        "observe-world",
        "trigger-science-vfx",
        "change-mission",
        "return-to-explore"
      ],
      "properties": {
        "boot-to-playable-world": {"type": "boolean"},
        "move-and-camera": {"type": "boolean"},
        "place-build-piece": {"type": "boolean"},
        "observe-world": {"type": "boolean"},
        "trigger-science-vfx": {"type": "boolean"},
        "change-mission": {"type": "boolean"},
        "return-to-explore": {"type": "boolean"}
      }
    },
    "installLogFile": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240},
    "installLogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeLogFile": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240},
    "runtimeLogSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "screenshotFile": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240},
    "screenshotSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "v8EvidenceFile": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$", "maxLength": 240},
    "v8EvidenceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
