{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldmakers.local/schemas/authored-assets-p1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "units", "upAxis", "forwardAxis", "sourceFormats", "assets"],
  "properties": {
    "schemaVersion": {"const": 1},
    "units": {"const": "centimeters"},
    "upAxis": {"const": "Z"},
    "forwardAxis": {"const": "X"},
    "sourceFormats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["fbx", "gltf", "blend", "sbsar", "json"]}
    },
    "assets": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "objectPath", "sourcePath", "collisionPolicy", "fallbackMode", "minLods", "maxMaterialSlots", "authoredPresent"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
          "kind": {"enum": ["StaticMesh", "SkeletalMesh", "Material", "NiagaraSystem", "AnimationBlueprint", "LevelSequence", "DataAsset"]},
          "objectPath": {"type": "string", "pattern": "^/Game/WorldMakers/[A-Za-z0-9_./-]+\\.[A-Za-z0-9_]+$"},
          "sourcePath": {"type": "string", "pattern": "^SourceArt/WorldMakers/[A-Za-z0-9_./-]+$"},
          "collisionPolicy": {"enum": ["none", "proxy", "authored-simple"]},
          "fallbackMode": {"enum": ["procedural", "legacy", "none"]},
          "minLods": {"type": "integer", "minimum": 1, "maximum": 8},
          "maxMaterialSlots": {"type": "integer", "minimum": 1, "maximum": 4},
          "authoredPresent": {"type": "boolean"}
        }
      }
    }
  }
}
