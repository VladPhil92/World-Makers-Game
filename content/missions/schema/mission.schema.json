{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldmakers.example/schemas/mission.schema.json",
  "title": "World Makers Pedagogical Mission",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "axis", "ageBand", "learningObjectives", "playerGoalKey", "mechanics", "evidenceEvents", "difficulty", "review", "runtime"],
  "properties": {
    "id": { "type": "string", "pattern": "^mission\\.[a-z0-9._-]+$" },
    "axis": { "enum": ["mathematics", "science", "language-narrative", "history-culture", "ethics-philosophy"] },
    "discipline": {
      "enum": [
        "mathematics",
        "geometry",
        "english-language",
        "spanish-language",
        "literature",
        "biology",
        "chemistry",
        "physics",
        "ecology",
        "ethics",
        "philosophy-for-children"
      ]
    },
    "secondaryDisciplines": {
      "type": "array",
      "items": {
        "enum": [
          "mathematics",
          "geometry",
          "english-language",
          "spanish-language",
          "literature",
          "biology",
          "chemistry",
          "physics",
          "ecology",
          "ethics",
          "philosophy-for-children"
        ]
      }
    },
    "conceptTags": { "type": "array", "items": { "type": "string" } },
    "depthLayers": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["experience", "concept", "formalization"] }
    },
    "ageBand": { "enum": ["4-6", "7-8", "9-10"] },
    "learningObjectives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "playerGoalKey": { "type": "string" },
    "mechanics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceEvents": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "scaffolds": { "type": "array", "items": { "type": "string" } },
    "localizationKeys": { "type": "array", "items": { "type": "string" } },
    "analyticsClassification": { "enum": ["none", "minimized-learning-evidence"] },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pedagogy", "safety"],
      "properties": {
        "pedagogy": { "enum": ["draft", "approved", "changes-requested"] },
        "safety": { "enum": ["draft", "approved", "changes-requested"] },
        "cultural": { "enum": ["not-required", "draft", "approved", "changes-requested"] }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "rewardIds", "prototypeOnly"],
      "properties": {
        "evaluator": { "enum": ["measure-and-build", "observe-ecosystem", "composable"] },
        "targetSpanCm": { "type": "number", "minimum": 50, "maximum": 5000 },
        "toleranceCm": { "type": "number", "minimum": 0, "maximum": 500 },
        "observationRequirements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observationId", "evidenceEventId", "objectiveId"],
            "properties": {
              "observationId": { "type": "string", "pattern": "^observation\\.[a-z0-9._-]+$" },
              "evidenceEventId": { "type": "string" },
              "objectiveId": { "type": "string" }
            }
          }
        },
        "evidencePrimitives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["primitiveId", "evidenceEventId", "objectiveId"],
            "properties": {
              "primitiveId": {
                "enum": [
                  "construct-to-constraint",
                  "observe-and-classify",
                  "predict-test-revise",
                  "sequence-and-infer",
                  "communicate-in-language",
                  "model-system",
                  "solve-spatial-system",
                  "interpret-text-world",
                  "reason-through-dilemma",
                  "argue-and-revise"
                ]
              },
              "evidenceEventId": { "type": "string" },
              "objectiveId": { "type": "string" },
              "requiredCount": { "type": "integer", "minimum": 1, "maximum": 20 }
            }
          }
        },
        "rewardIds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^reward\\.[a-z0-9._-]+$" }
        },
        "prerequisiteMissionIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^mission\\.[a-z0-9._-]+$" }
        },
        "prototypeOnly": { "type": "boolean" }
      }
    }
  }
}
